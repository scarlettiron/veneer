{
  "name": "@veneer/server",
  "version": "0.1.0",
  "description": "Framework agnostic Node backend handler for Veneer",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@veneer/auth-jwt": "workspace:*",
    "@veneer/core": "workspace:*",
    "@veneer/postgres": "workspace:*"
  },
  "peerDependencies": {
    "@veneer/mysql": "workspace:*",
    "@veneer/sqlite": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@veneer/mysql": {
      "optional": true
    },
    "@veneer/sqlite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
